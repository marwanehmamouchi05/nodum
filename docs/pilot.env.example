# Template only: use a NEW database outside the source checkout.
APP_ENV=production
NODUM_AUTHORIZATION_MODE=scoped
DATABASE_URL=sqlite:///C:/nodum-data/pilot.db
HOST=127.0.0.1
PORT=8000
AUTH_PUBLIC_ORIGIN=https://nodum.example
AUTH_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
FORWARDED_ALLOW_IPS=
ACCESS_LOG=false
NODUM_AI_ENABLED=false
RING_MODE=simulation
RING_REQUIRED=false
# Configure real TLS ingress and replace the example origin before pilot use.
# Provision using provision_admin.py, then configure the building through Admin.
# This file contains no provider credentials and does not enable real hardware.
