VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_USE_CREDENTIALS=false
# Set true for a separately served, same-site frontend using Nodum sessions.
# Backend: exact CORS_ALLOWED_ORIGINS, CORS_ALLOW_CREDENTIALS=true and
# AUTH_TRUSTED_ORIGINS must include this frontend origin.
# Production: https://nodum-production.up.railway.app
# Public build-time configuration only. Never put AWS or Ring secrets here.
