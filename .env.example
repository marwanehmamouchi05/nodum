# Application startup: python -m app.run --env-file ../.env
# For Docker, override HOST=0.0.0.0 and DATABASE_URL=sqlite:////data/nodum.db.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Off by default in production to avoid logging account-link query parameters.
ACCESS_LOG=false
GRACEFUL_SHUTDOWN_SECONDS=30
# Empty means no cross-origin browser access. Comma-separated exact origins only.
# Development example: http://localhost:5173
# Production example: https://nodum.example.com (no trailing slash)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# Required production auth origin (HTTPS, no trailing slash).
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Additional exact frontend origins permitted to submit authenticated requests.
# Also configure CORS_ALLOWED_ORIGINS and CORS_ALLOW_CREDENTIALS=true.
AUTH_TRUSTED_ORIGINS=
AUTH_SESSION_HOURS=8
# Optional first-run provisioning. Set all three privately; no default password.
# Existing passwords are never reset by startup.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_PERSON_ID=
# Exact trusted TLS proxy IPs/CIDRs only. Empty disables proxy-header trust.
FORWARDED_ALLOW_IPS=
# Production requires an absolute path on persistent writable storage.
DATABASE_URL=sqlite:///./nodum.db

AWS_REGION=eu-north-1
# Optional AI adapter. Credentials are resolved by the AWS SDK credential chain.
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
NODUM_AI_ENABLED=true
# Prefer an IAM workload role; leave credentials unset when using one.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional local SDK configuration (leave unset when unused):
# AWS_PROFILE=nodum
# AWS_SHARED_CREDENTIALS_FILE=/path/to/credentials
# AWS_CONFIG_FILE=/path/to/config
# AWS_DEFAULT_REGION=eu-north-1

# Opt in to fail-fast Ring configuration validation at startup.
# false keeps the existing optional/lazy Ring behavior; it does not disable routes.
RING_REQUIRED=false
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Optional Ring integration. No Ring network calls occur during app startup.
# Staging/production scope local records; configure each deployment separately.
RING_ENVIRONMENT=staging
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_SIGNING_KEY=
# Legacy alias used when RING_SIGNING_KEY is unset or empty:
RING_WEBHOOK_SECRET=
# Independent Fernet key for tokens at rest; keep stable across restarts.
RING_ENCRYPTION_KEY=
# Public HTTPS URLs registered in the Ring portal after deployment.
# Account Link URL must point to an authenticated Nodum sign-in UI.
RING_ACCOUNT_LINK_URL=
RING_TOKEN_EXCHANGE_URL=
RING_WEBHOOK_URL=
RING_HOMEPAGE_URL=
