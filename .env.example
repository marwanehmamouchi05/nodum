AWS_REGION=eu-north-1
# Optional AI adapter. Credentials are resolved by the AWS SDK credential chain.
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
NODUM_AI_ENABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATABASE_URL=sqlite:///./nodum.db
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Optional Ring integration. No Ring network calls occur during app startup.
# Staging/production scope local records; configure each deployment separately.
RING_ENVIRONMENT=staging
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_SIGNING_KEY=
# Legacy alias used only when RING_SIGNING_KEY is unset:
RING_WEBHOOK_SECRET=
# Independent Fernet key for tokens at rest; keep stable across restarts.
RING_ENCRYPTION_KEY=
# Public HTTPS URLs registered in the Ring portal after deployment.
# Account Link URL must point to an authenticated Nodum sign-in UI.
RING_ACCOUNT_LINK_URL=
RING_TOKEN_EXCHANGE_URL=
RING_WEBHOOK_URL=
RING_HOMEPAGE_URL=
